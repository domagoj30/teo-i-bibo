91248,15408],"Jedan plus jedan je dva.":[2206656,16128],"Koliko je jedan plus dva?":[2222784,14832],"Jedan plus dva je tri.":[2237616,14976],"Koliko je jedan plus tri?":[2252592,14400],"Jedan plus tri je četiri.":[2266992,15552],"Koliko je jedan plus četiri?":[2282544,15696],"Jedan plus četiri je pet.":[2298240,16128],"Koliko je jedan plus pet?":[2314368,15120],"Jedan plus pet je šest.":[2329488,15984],"Koliko je jedan plus šest?":[2345472,15840],"Jedan plus šest je sedam.":[2361312,16992],"Koliko je jedan plus sedam?":[2378304,15120],"Jedan plus sedam je osam.":[2393424,16272],"Koliko je jedan plus osam?":[2409696,15264],"Jedan plus osam je devet.":[2424960,16272],"Koliko je jedan plus devet?":[2441232,15264],"Jedan plus devet je deset.":[2456496,16848],"Koliko je dva plus jedan?":[2473344,14832],"Dva plus jedan je tri.":[2488176,15408],"Koliko je dva plus dva?":[2503584,14544],"Dva plus dva je četiri.":[2518128,15984],"Koliko je dva plus tri?":[2534112,14256],"Dva plus tri je pet.":[2548368,14832],"Koliko je dva plus četiri?":[2563200,15264],"Dva plus četiri je šest.":[2578464,16848],"Koliko je dva plus pet?":[2595312,14400],"Dva plus pet je sedam.":[2609712,14976],"Koliko je dva plus šest?":[2624688,15552],"Dva plus šest je osam.":[2640240,16848],"Koliko je dva plus sedam?":[2657088,14688],"Dva plus sedam je devet.":[2671776,15984],"Koliko je dva plus osam?":[2687760,14688],"Dva plus osam je deset.":[2702448,16272],"Koliko je tri plus jedan?":[2718720,14688],"Tri plus jedan je četiri.":[2733408,15696],"Koliko je tri plus dva?":[2749104,14400],"Tri plus dva je pet.":[2763504,14400],"Koliko je tri plus tri?":[2777904,13824],"Tri plus tri je šest.":[2791728,14688],"Koliko je tri plus četiri?":[2806416,15408],"Tri plus četiri je sedam.":[2821824,15552],"Koliko je tri plus pet?":[2837376,14256],"Tri plus pet je osam.":[2851632,14256],"Koliko je tri plus šest?":[2865888,15264],"Tri plus šest je devet.":[2881152,16272],"Koliko je tri plus sedam?":[2897424,14256],"Tri pl