{"v":1795248715,"voice":"hr-HR-SreckoNeural","size":6191568,"clips":{"Bok, Teo!":[0,12096],"Kamo ronimo danas?":[12096,13248],"Odaberi sljedeći zaron!":[25344,15264],"Prvo završi prethodni zaron!":[40608,16848],"Vozi podmornicu strelicama!":[57456,17280],"Doplovi do točnog broja!":[74736,15552],"To nije točan broj.":[90288,13536],"Sada odgovaraj glasom!":[103824,14400],"Što je ovo?":[118224,11232],"Reci glasno!":[129456,11520],"Koje je boje ova riba?":[140976,13104],"Koliko ima bisera?":[154080,13104],"Reci broj!":[167184,11232],"Nisam dobro čuo.":[178416,13536],"Reci još jednom, glasno!":[191952,16272],"Pokaži mi klikom!":[208224,12528],"Mikrofon ne radi.":[220752,13680],"Odgovaraj klikom!":[234432,12528],"Što ovdje ne pripada?":[246960,14112],"Što dolazi sljedeće?":[261072,14832],"Koliko ih je zajedno?":[275904,13248],"Bravo, Teo!":[289152,12384],"Pronašao si biser!":[301536,12816],"Istražio si ovaj dio mora!":[314352,16272],"Ronimo dublje!":[330624,11808],"Teo, istražio si cijelo more!":[342432,18720],"Ti si pravi kapetan!":[361152,13392],"Bravo!":[374544,11232],"Tako je!":[385776,11232],"Odlično!":[397008,11232],"Izvrsno!":[408240,11232],"Točno!":[419472,11232],"Sjajno!":[430704,11232],"Pokušaj ponovno!":[441936,12096],"Pogledaj još jednom!":[454032,12528],"Zamalo!":[466560,11232],"Pokušaj ponovno.":[477792,12384],"Skupi sve crvene mjehuriće!":[490176,16992],"To nije crveni mjehurić.":[507168,14832],"Riba je crvena!":[522000,11952],"Klikni na crvenu boju!":[533952,14544],"Skupi sve plave mjehuriće!":[548496,16704],"To nije plavi mjehurić.":[565200,14688],"Riba je plava!":[579888,11376],"Klikni na plavu boju!":[591264,14112],"Skupi sve žute mjehuriće!":[605376,16416],"To nije žuti mjehurić.":[621792,14688],"Riba je žuta!":[636480,11664],"Klikni na žutu boju!":[648144,13968],"Skupi sve zelene mjehuriće!":[662112,16992],"To nije zeleni mjehurić.":[679104,15264],"Riba je zelena!":[694368,11952],"Klikni na zelenu boju!":[706320,14688],"Skupi sve narančaste mjehuriće!