{"v":1795112477,"voice":"hr-HR-SreckoNeural","size":14738832,"clips":{"Bok, Teo!":[0,12096],"Ja sam Bibo, tvoj robot prijatelj.":[12096,19152],"Ovo je naš svemirski brod!":[31248,15984],"Strelicama doleti do planeta!":[47232,17712],"Svi planeti su tvoji!":[64944,14400],"Doleti do planeta i igraj opet!":[79344,18288],"Na koji planet letimo sada?":[97632,15984],"Strelicama doleti do planeta ili klikni na planet!":[113616,24192],"Vidiš li balone?":[137808,13248],"Pomakni strelicu na balon i klikni!":[151056,18432],"Pomozi mi doći do zvjezdice.":[169488,17136],"Pritisni strelice na tipkovnici!":[186624,18000],"Zvjezdica je visoko.":[204624,14112],"Pritisni veliku dugu tipku da skočim!":[218736,20160],"Zvjezdice padaju s neba!":[238896,15984],"Strelicama lijevo i desno dovedi me ispod zvjezdice!":[254880,25488],"Leptiri!":[280368,11232],"Ulovi ih!":[291600,11232],"Klikni ih dok lete!":[302832,13248],"Ulovi leptire!":[316080,12384],"Trčimo!":[328464,11232],"Preskoči balvan!":[339696,12240],"Pritisni dugu tipku kad dođe blizu!":[351936,19584],"Ups!":[371520,11232],"Pritisni dugu tipku kad balvan dođe blizu!":[382752,22032],"Idemo svirati!":[404784,12240],"Pritisni tipke s brojevima!":[417024,15552],"Bravo!":[432576,11232],"Kakva glazba!":[443808,11232],"Voće pada s neba!":[455040,13536],"Strelicama lijevo i desno dovedi me ispod voća!":[468576,24480],"Njam njam!":[493056,11232],"Hvala!":[504288,11232],"Pronađi dvije iste sličice!":[515520,16272],"Klikni na karticu!":[531792,12672],"Dvije iste sličice!":[544464,13968],"Nisu iste.":[558432,11232],"Probaj opet!":[569664,11232],"Skupi sve zvjezdice!":[580896,14976],"Svemirci se skrivaju!":[595872,14112],"Brzo, klikni svemirca!":[609984,15984],"Bravo, Teo!":[625968,12384],"Osvojio si sve planete!":[638352,15696],"Ti si pravi prvak!":[654048,12960],"Osvojio si cijeli planet!":[667008,15408],"Letimo na sljedeći!":[682416,13536],"Idemo brojati!":[695952,11952],"Koliko je zvjezdica?":[707904,13536],"Pritisni taj broj!":[721440,1252