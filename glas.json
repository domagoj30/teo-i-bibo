{"v":1795208108,"voice":"hr-HR-SreckoNeural","size":14830992,"clips":{"Bok, Teo!":[0,12096],"Ja sam Bibo, tvoj robot prijatelj.":[12096,19152],"Ovo je naš svemirski brod!":[31248,15984],"Strelicama doleti do planeta!":[47232,17712],"Svi su planeti tvoji!":[64944,14112],"Doleti do planeta i igraj opet!":[79056,18288],"Na koji planet letimo sada?":[97344,15984],"Strelicama doleti do planeta ili klikni na planet!":[113328,24192],"Vidiš li balone?":[137520,13248],"Pomakni strelicu na balon i klikni!":[150768,18432],"Pomozi mi doći do zvjezdice.":[169200,17136],"Pritisni strelice na tipkovnici!":[186336,18000],"Zvjezdica je visoko.":[204336,14112],"Pritisni veliku dugu tipku da skočim!":[218448,20160],"Zvjezdice padaju s neba!":[238608,15984],"Strelicama lijevo i desno dovedi me ispod zvjezdice!":[254592,25488],"Leptiri!":[280080,11232],"Ulovi ih!":[291312,11232],"Klikni na njih dok lete!":[302544,15552],"Ulovi leptire!":[318096,12384],"Trčimo!":[330480,11232],"Preskoči balvan!":[341712,12240],"Pritisni dugu tipku kad dođe blizu!":[353952,19584],"Joj!":[373536,11232],"Pritisni dugu tipku kad balvan dođe blizu!":[384768,22032],"Idemo svirati!":[406800,12240],"Pritisni tipke s brojevima!":[419040,15552],"Bravo!":[434592,11232],"Kakva glazba!":[445824,11232],"Voće pada s neba!":[457056,13536],"Strelicama lijevo i desno dovedi me ispod voća!":[470592,24480],"Njam njam!":[495072,11232],"Hvala!":[506304,11232],"Pronađi dvije iste sličice!":[517536,16272],"Klikni na karticu!":[533808,12672],"Dvije iste sličice!":[546480,13968],"Nisu iste.":[560448,11232],"Probaj opet!":[571680,11232],"Skupi sve zvjezdice!":[582912,14976],"Svemirci se skrivaju!":[597888,14112],"Brzo, klikni na svemirca!":[612000,16848],"Bravo, Teo!":[628848,12384],"Osvojio si sve planete!":[641232,15696],"Ti si pravi prvak!":[656928,12960],"Osvojio si cijeli planet!":[669888,15408],"Letimo na sljedeći!":[685296,13536],"Idemo brojati!":[698832,11952],"Koliko je zvjezdica?":[710784,13536],"Pritisni taj broj!":[724320,12528],"Izbroji zvjezdice i pritisni taj broj!":[736848,19728],"Izbroji opet!":[756576,12384],"Tražimo životinje!":[768960,13248],"Poslušaj kako se životinje glasaju!":[782208,18720],"Pogledaj sličice!":[800928,12816],"Tražimo oblike!":[813744,12528],"Sada pazi!":[826272,11520],"Pogledaj lica!":[837792,11520],"Tražimo odjeću!":[849312,11952],"Pogledaj nebo!":[861264,11520],"Što ovdje ne pripada?":[872784,14112],"Gladan sam!":[886896,11232],"Klikni na njega!":[898128,12096],"Tako je!":[910224,11232],"Tražimo brojeve na tipkovnici!":[921456,16848],"Lansiramo raketu!":[938304,13248],"Odbrojavaj sa mnom!":[951552,13248],"Tražimo slova na tipkovnici!":[964800,16416],"Jedan!":[981216,11232],"Kreni!":[992448,11232],"Raketa leti!":[1003680,11520],"Nisam dobro čuo.":[1015200,13536],"Reci još jednom, glasno!":[1028736,16272],"Sada mi odgovaraj glasom!":[1045008,15264],"Što je ovo?":[1060272,11232],"Reci glasno!":[1071504,11520],"Kakav je ovo balon?":[1083024,13104],"Koje je boje?":[1096128,11232],"Izbroji zvjezdice i reci mi broj!":[1107360,19008],"Koliko ih je?":[1126368,11232],"Reci broj!":[1137600,11232],"Izbroji sa mnom!":[1148832,11952],"Mikrofon ne radi.":[1160784,13680],"Odgovaraj klikom!":[1174464,12528],"Hi hi hi!":[1186992,11520],"To škaklja!":[1198512,11232],"Sada tražimo boje!":[1209744,13824],"Gledaj koliko su veliki!":[1223568,14832],"Pogledaj dvije hrpe zvjezdica!":[1238400,16848],"Pritisni strelice na tipkovnici i dovedi me do zvjezdice!":[1255248,26928],"Tražimo hranu!":[1282176,11952],"Sve si pronašao!":[1294128,13248],"Tražimo vozila!":[1307376,12240],"Vozimo se!":[1319616,11232],"Slušaj kamo skrećemo!":[1330848,14112],"Skreni lijevo!":[1344960,12096],"Skreni desno!":[1357056,11952],"Idi gore!":[1369008,11232],"Idi dolje!":[1380240,11232],"To je lijevo.":[1391472,11232],"To je desno.":[1402704,11232],"To je gore.":[1413936,11232],"To je dolje.":[1425168,11232],"Ovo je semafor!":[1436400,11808],"Kad je zeleno, pritisni dugu tipku!":[1448208,19728],"Kad j