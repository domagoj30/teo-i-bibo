{"v":1795169148,"voice":"hr-HR-SreckoNeural","size":680400,"clips":{"Bok, Teo!":[0,12096],"Idemo u pustolovinu!":[12096,14256],"Trči strelicama.":[26352,13104],"Skoči razmaknicom!":[39456,13392],"Pazi, ljigavac!":[52848,13536],"Skoči na njega ili se zavrti tipkom X.":[66384,23328],"Za veliki skok pritisni razmaknicu dvaput!":[89712,21888],"Pričekaj ploču pa skoči na nju!":[111600,16992],"Kutije razbij vrtnjom!":[128592,13680],"Skoči na oprugu!":[142272,12528],"Zastavica!":[154800,11232],"Odavde nastavljamo.":[166032,13392],"Kristal!":[179424,11232],"Bravo!":[190656,11232],"Još jedan kristal!":[201888,13104],"Imaš sva tri kristala!":[214992,16272],"Svaka čast!":[231264,11664],"Ovo je pješčana plaža.":[242928,14688],"Pazi, neke ploče padaju!":[257616,16272],"Bodljikavu kuglu ne možeš pobijediti.":[273888,20880],"Preskoči je!":[294768,11232],"Ova ploča ide gore i dolje.":[306000,17424],"Stani na nju!":[323424,11376],"Brrr, ledeni vrh!":[334800,17424],"Led je sklizak, idi polako.":[352224,17856],"Ovo je vulkan!":[370080,11520],"Ne padaj u lavu.":[381600,12672],"Svemirska postaja!":[394272,13824],"Ovdje se skače jako visoko.":[408096,17136],"Ajme, Veliki Ljigavac!":[425232,16272],"Skoči mu na glavu tri puta!":[441504,16848],"Tako je!":[458352,11232],"Još jednom!":[469584,11232],"Pobijedio si Velikog Ljigavca!":[480816,16560],"Raketa nas čeka!":[497376,12960],"Prešao si sve staze!":[510336,14256],"Ti si prvak svemira!":[524592,14112],"Odaberi stazu!":[538704,12384],"Ups!":[551088,11232],"Idemo opet!":[562320,11520],"Ništa strašno.":[573840,12672],"Probaj ponovno!":[586512,11520],"Skoro!":[598032,11232],"Bravo, Teo!":[609264,12384],"Stigli smo do rakete!":[621648,14256],"Odlično, Teo!":[635904,13536],"Prešao si cijelu stazu!":[649440,14832],"Teo, ti si pravi junak!":[664272,16128]}}